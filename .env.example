# Value of the steamLoginSecure cookie from https://store.steampowered.com
# Treat it like a password. It expires after a while; grab a fresh one if fetch says you're logged out.
STEAM_LOGIN_SECURE=

# Optional. Adds playtime (hours played, last played, cost per hour) to the dashboard.
# Get one at https://steamcommunity.com/dev/apikey. Also a secret.
STEAM_API_KEY=
